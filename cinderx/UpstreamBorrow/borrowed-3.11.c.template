// _pydict_global_version is private to the target libpython. Allocate from the
// runtime's real version stream by mutating a private clock dict, rather than
// maintaining a second counter that could collide with stock dict versions.
static PyObject* ci_dict_version_clock;
static PyObject* ci_dict_version_key;
static unsigned int ci_dict_version_clock_value;

uint64_t Cix_PyDict_NextVersion(void) {
  PyObject* value =
      (++ci_dict_version_clock_value & 1) ? Py_True : Py_False;
  if (PyDict_SetItem(ci_dict_version_clock, ci_dict_version_key, value) < 0) {
    Py_FatalError("CinderX failed to allocate a CPython 3.11 dict version");
  }
  return ((PyDictObject*)ci_dict_version_clock)->ma_version_tag;
}

