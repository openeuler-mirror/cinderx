function(cinderx_generate_coroutine_ceval_311 output_dir)
  set(upstream "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/upstream/ceval.c")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${upstream}")
  file(SHA256 "${upstream}" digest)
  if(NOT digest STREQUAL "10723274040fd4da5ac82365712ae91462286faff6421ffcf32fa5fba7ab8048")
    message(FATAL_ERROR "CPython 3.11 coroutine call patch requires the pinned ceval.c")
  endif()
  file(READ "${upstream}" source)
  set(old "Py_TYPE(function) == &PyFunction_Type && tstate->interp->eval_frame == NULL")
  set(new "Py_TYPE(function) == &PyFunction_Type && Ci_CanInlineCoroutineCall311(tstate, function, total_args, call_shape.kwnames)")
  string(REPLACE "${old}" "" removed "${source}")
  string(LENGTH "${source}" before)
  string(LENGTH "${removed}" after)
  string(LENGTH "${old}" size)
  math(EXPR found "${before} - ${after}")
  if(NOT found EQUAL size)
    message(FATAL_ERROR "Expected exactly one generic CALL inline condition")
  endif()
  string(REPLACE "${old}" "${new}" source "${source}")
  set(old "TARGET(CALL_PY_EXACT_ARGS) {\n            assert(call_shape.kwnames == NULL);\n            DEOPT_IF(tstate->interp->eval_frame, CALL);")
  set(new "TARGET(CALL_PY_EXACT_ARGS) {\n            assert(call_shape.kwnames == NULL);\n            DEOPT_IF(!Ci_CanInlineCoroutineCall311(tstate, PEEK(oparg + is_method(stack_pointer, oparg) + 1), oparg + is_method(stack_pointer, oparg), call_shape.kwnames), CALL);")
  string(FIND "${source}" "${old}" position)
  if(position LESS 0)
    message(FATAL_ERROR "Expected the pinned CALL_PY_EXACT_ARGS evaluator guard")
  endif()
  string(REPLACE "${old}" "${new}" source "${source}")
  set(output "${output_dir}/cinderx/Interpreter/3.11/coroutine_ceval.c")
  file(MAKE_DIRECTORY "${output_dir}/cinderx/Interpreter/3.11")
  if(EXISTS "${output}")
    file(READ "${output}" previous)
  endif()
  if(NOT source STREQUAL previous)
    file(WRITE "${output}" "${source}")
  endif()
endfunction()
